# --- Stack gabungan (docker compose di root) ---
# SALIN jadi `.env` di root repo. File `.env` sudah di-`.gitignore`.

# ============ PROFIL LOKAL (chain Hardhat di dalam Docker) ============
# Jalankan:  docker compose --profile local up -d --build
# Tidak perlu mengisi apa pun di bawah: alamat kontrak di-deploy otomatis oleh
# service `deploy` dan dibaca collector + dashboard dari volume /state.
# Alamat RPC yang dipakai BROWSER dashboard (harus bisa diakses dari host).
# Profil lokal: chain dipublikasikan di 127.0.0.1:8545 (biarkan default).
BROWSER_RPC_URL=http://127.0.0.1:8545

BATCH_SIZE=20
FLUSH_INTERVAL_MS=30000
SCAN_INTERVAL_MS=10000
VERIFY_INTERVAL_MS=30000

# ============ PROFIL SEPOLIA (tanpa chain lokal) ============
# Jalankan:  docker compose up -d --build     (service chain & deploy dilewati)
# Isi tiga variabel di bawah, lalu pakai akun server ber-role SOC_ANALYST
# (JANGAN akun owner/deployer). Lihat HANDOVER.md bagian role.
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# CONTRACT_ADDRESS=0x1E6b3BFb571910e05080dDD16ecc2AC0f760BbBd
# PRIVATE_KEY=
# (Sepolia) browser memakai URL publik yang sama:
# BROWSER_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Port dashboard di host (default 8088) dan port SSH server korban (default 2222)
DASHBOARD_PORT=8088
VICTIM_SSH_PORT=2222

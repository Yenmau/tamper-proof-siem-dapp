# Konfigurasi backend log collector (logCollector.js & merkleCollector.js).
# SALIN file ini jadi `.env` DI FOLDER YANG SAMA (integration/backend/.env),
# lalu isi nilainya. Kedua skrip membaca file itu otomatis (path relatif ke
# lokasi skrip, bukan ke current working directory), jadi bisa dijalankan
# dari mana pun. JANGAN commit file `.env` — sudah ditutup `.gitignore`.

# Endpoint RPC: node lokal http://127.0.0.1:8545, atau testnet (contoh Sepolia)
RPC_URL=https://rpc.sepolia.org

# Alamat kontrak hasil deploy (lihat deployments.json di root repo)
CONTRACT_ADDRESS=

# Private key akun yang sudah diberi role SOC_ANALYST atau ADMIN.
# PENTING: pakai akun khusus server, JANGAN akun pribadi/utama.
# 0x..........
PRIVATE_KEY=

# Opsional — default: ../../contracts/SIEMLogger.json
# ABI_PATH=./SIEMLogger.json

# OPSIONAL — hanya dipakai merkleCollector.js (penyimpanan baris log off-chain).
# Biarkan KOSONG kalau tidak mau memakai MongoDB: skripnya tetap jalan, hanya
# saja perbandingan baris demi baris tidak tersedia (bandingkan dengan flag
# `--no-db`). logCollector.js tidak memakai variabel ini sama sekali.
# Contoh lokal : mongodb://127.0.0.1:27017/siem_logs
# Contoh Atlas : mongodb+srv://<username>:<password>@cluster0.mongodb.net/siem_logs
MONGO_URI=

# Konfigurasi backend log collector.
# SALIN file ini jadi `.env` lalu isi nilainya.  JANGAN commit file `.env`.

# Endpoint RPC testnet (contoh Sepolia; ganti kalau pakai Amoy)
RPC_URL=https://rpc.sepolia.org

# Alamat kontrak hasil deploy (lihat deployments.json di root repo)
CONTRACT_ADDRESS=

# Private key akun yang sudah diberi role SOC_ANALYST atau ADMIN.
# PENTING: pakai akun khusus server, JANGAN akun pribadi/utama.
# 0x..........
PRIVATE_KEY=

# Opsional — default: ../../contracts/SIEMLogger.json
# ABI_PATH=./SIEMLogger.json
